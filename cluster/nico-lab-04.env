# nico-lab SNO + NICo deployment on nvd-srv-04 — 2026-09-29
# Re-creation of the nvd-srv-44 nico-lab cluster (see nico-lab-44-snapshot.md).
# Values for `make bootstrap-cluster` (Makefile) and the NICo day-2 deploy.
# Keep in sync with nico-lab-44-snapshot.md. No secret material in this file.

# --- Cluster (identical to 44; DNS records stay valid) -----------------------
NICO_CLUSTER_NAME=nico-lab
NICO_BASE_DOMAIN=szigmon.okoyl.xyz
NICO_OPENSHIFT_VERSION=4.22.7-multi
NICO_API_IP=10.6.135.50
NICO_GW=10.6.135.254
NICO_DNS=10.11.5.160
NICO_NETMASK=24

# --- VM (matches 44: 14 vCPU / 40 GiB / 120+80 GiB, UEFI, host-passthrough) ---
NICO_VM_PREFIX=vm-nico-lab
NICO_VCPUS=14
NICO_RAM=41984
NICO_DISK1=120
NICO_DISK2=80
NICO_DISK_PATH=/home/libvirt/images

# --- Networking (04 deltas vs 44) --------------------------------------------
# 44 had a single NIC on br0. 04 adds:
NICO_BRIDGE=mgmt-br            # 04 host bridge (10.6.135.54/24)
NICO_EXTRA_NETWORKS=default    # libvirt NAT network 192.168.122.0/24
NICO_EXTRA_BRIDGES=br1         # Linux bridge = L2 to physical VLAN 712

# --- Credentials (live on 04 only; never commit contents) ---------------------
NICO_PULL_SECRET=/root/openshift_pull.json
NICO_SSH_PUB_KEY=/root/.ssh/id_ed25519.pub

# --- Storage -------------------------------------------------------------------
NICO_OLM_WORKAROUND=true
STORAGE_TYPE=lvm
BFB_STORAGE_CLASS=lvms-vg1     # LVMS StorageClass, set as default by bootstrap

# --- VLAN 712 (day-2 NICo DHCP/DNS/PXE; served by cluster, not the host) ------
VLAN712_NETWORK=10.6.145.0/24
VLAN712_BRIDGE=br1             # host bridge carrying physical VLAN 712
# OVN local-gateway mode (day-1) so MetalLB LoadBalancer VIPs work on the
# dedicated VLAN NIC. Without it, OVN (shared-gateway) drops VIP traffic on the
# secondary interface. Applied at install by bootstrap.sh.
NICO_LOCAL_GATEWAY=true

# --- Bootstrap invocation -------------------------------------------------------
# make bootstrap-cluster NICO_CLUSTER_NAME=nico-lab NICO_BASE_DOMAIN=szigmon.okoyl.xyz \
#   NICO_API_IP=10.6.135.50 NICO_GW=10.6.135.254 NICO_DNS=10.11.5.160 \
#   NICO_BRIDGE=mgmt-br NICO_EXTRA_NETWORKS=default NICO_EXTRA_BRIDGES=br1 \
#   NICO_DISK_PATH=/home/libvirt/images \
#   NICO_PULL_SECRET=/root/openshift_pull.json NICO_SSH_PUB_KEY=/root/.ssh/id_ed25519.pub
